table inet kuport {
	chain kup-steer {
		type filter hook prerouting priority dstnat - 20; policy accept;
	}
	chain kup-pre {
		type nat hook prerouting priority dstnat - 20; policy accept;
		meta nfproto ipv4 iifname "enp1s0" udp dport 27015-27115 counter dnat ip to 10.244.18.107:27015-27115
		meta nfproto ipv4 iifname "wt0" udp dport 27015-27115 counter dnat ip to 10.244.18.107:27015-27115
	}
	chain kup-post {
		type nat hook postrouting priority srcnat - 10; policy accept;
		oifname "cilium_host" ip daddr 10.244.18.107 udp dport 27015-27115 counter snat ip to ip saddr
	}
	chain kup-mangle {
		type filter hook prerouting priority mangle + 10; policy accept;
	}
	chain kup-egress {
		type filter hook prerouting priority dstnat + 10; policy accept;
	}
	chain kup-mss {
		type filter hook forward priority mangle; policy accept;
	}
	chain kup-count {
		type filter hook postrouting priority filter; policy accept;
		iifname "enp1s0" ip daddr 10.244.18.107 udp dport 27015-27115 ct direction original ct status dnat counter
		oifname "enp1s0" ip saddr 10.244.18.107 udp sport 27015-27115 ct direction reply ct status dnat counter
		iifname "wt0" ip daddr 10.244.18.107 udp dport 27015-27115 ct direction original ct status dnat counter
		oifname "wt0" ip saddr 10.244.18.107 udp sport 27015-27115 ct direction reply ct status dnat counter
	}
}
