table inet kuport {
	chain kup-steer {
		type filter hook prerouting priority dstnat - 20; policy accept;
	}
	chain kup-pre {
		type nat hook prerouting priority dstnat - 20; policy accept;
		meta nfproto ipv4 iifname "enp1s0" udp dport 3000 counter dnat ip to 10.244.18.107:3000
		meta nfproto ipv6 iifname "enp1s0" udp dport 3000 counter dnat ip6 to [fd00:10:244:12::6b]:3000
		meta nfproto ipv4 iifname "wt0" udp dport 3000 counter dnat ip to 10.244.18.107:3000
		meta nfproto ipv6 iifname "wt0" udp dport 3000 counter dnat ip6 to [fd00:10:244:12::6b]:3000
	}
	chain kup-post {
		type nat hook postrouting priority srcnat - 10; policy accept;
		oifname "cilium_host" ip daddr 10.244.18.107 udp dport 3000 counter snat ip to ip saddr
		oifname "cilium_host" ip6 daddr fd00:10:244:12::6b udp dport 3000 counter snat ip6 to ip6 saddr
	}
	chain kup-mangle {
		type filter hook prerouting priority mangle + 10; policy accept;
	}
	chain kup-egress {
		type filter hook prerouting priority dstnat + 10; policy accept;
	}
	chain kup-mss {
		type filter hook forward priority mangle; policy accept;
	}
	chain kup-count {
		type filter hook postrouting priority filter; policy accept;
		iifname "enp1s0" ip daddr 10.244.18.107 udp dport 3000 ct direction original ct status dnat counter
		oifname "enp1s0" ip saddr 10.244.18.107 udp sport 3000 ct direction reply ct status dnat counter
		iifname "enp1s0" ip6 daddr fd00:10:244:12::6b udp dport 3000 ct direction original ct status dnat counter
		oifname "enp1s0" ip6 saddr fd00:10:244:12::6b udp sport 3000 ct direction reply ct status dnat counter
		iifname "wt0" ip daddr 10.244.18.107 udp dport 3000 ct direction original ct status dnat counter
		oifname "wt0" ip saddr 10.244.18.107 udp sport 3000 ct direction reply ct status dnat counter
		iifname "wt0" ip6 daddr fd00:10:244:12::6b udp dport 3000 ct direction original ct status dnat counter
		oifname "wt0" ip6 saddr fd00:10:244:12::6b udp sport 3000 ct direction reply ct status dnat counter
	}
}
