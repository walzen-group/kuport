table inet kuport {
	map kup-steer4 {
		type ipv4_addr : ipv4_addr
		elements = { 169.254.77.1 : 169.254.76.1, 169.254.77.3 : 169.254.76.2 }
	}
	chain kup-steer {
		type filter hook prerouting priority dstnat - 20; policy accept;
		meta nfproto ipv4 iifname "kup-da0d9a1d" udp dport 3000 ip daddr set ip daddr map @kup-steer4 counter
		meta nfproto ipv4 iifname "kup-e5b1c204" udp dport 3000 ip daddr set ip daddr map @kup-steer4 counter
	}
	chain kup-pre {
		type nat hook prerouting priority dstnat - 20; policy accept;
		iifname "kup-da0d9a1d" ip daddr 169.254.76.1 udp dport 3000 counter dnat ip to 10.244.18.107:3000
		iifname "kup-e5b1c204" ip daddr 169.254.76.2 udp dport 3000 counter dnat ip to 10.244.18.107:3000
	}
	chain kup-post {
		type nat hook postrouting priority srcnat - 10; policy accept;
		oifname != "cilium_*" ip saddr 10.244.18.107 udp sport 3000 counter snat ip to ip saddr
	}
	chain kup-mangle {
		type filter hook prerouting priority mangle + 10; policy accept;
		ip saddr 10.244.18.107 udp sport 3000 counter meta mark set ct mark
		iifname "kup-da0d9a1d" counter ct mark set 0x6b700001
		iifname "kup-e5b1c204" counter ct mark set 0x6b700002
	}
}
